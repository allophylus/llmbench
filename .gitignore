# benchmark videos are rendered locally and served from CloudFront, never committed
videos/
*.mp4
*.webm
# ...except the games cell: the recorded build and robot run ARE the evidence, so they
# are published with the results. Only the compressed copies are tracked:
!games/*/robot_play_repo.mp4
!games/*/attempts/*/build.webm
# the passing game's screen recording is published with the cell
!games/*-physics/video/physics-3d.webm

# tooling / editor noise
node_modules/
.DS_Store
__pycache__/
*.pyc
.venv/

# editor / manual backups
*.bak
*.bak-*
